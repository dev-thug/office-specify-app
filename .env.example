# Office environment (see crates/infrastructure/src/config.rs)
# APP_ENV is required to be one of development|test|production.
# Unset → treated as production (fail closed); unknown → startup error.
APP_ENV=development
DATABASE_URL=postgres://hyunjoong@localhost:5432/outreach_dev
REDIS_URL=redis://localhost:6379             # REQUIRED in production (rate limits fail closed)
API_ADDR=127.0.0.1:8080
MCP_ADDR=127.0.0.1:8081
# Public Next.js origin used in recipient booking/unsubscribe links. HTTPS in production.
PUBLIC_BASE_URL=http://localhost:3000

# TCP proxies trusted to set X-Forwarded-For (CIDR CSV). XFF is only
# honored when the connecting peer is in this list; default is loopback
# only (the Next.js server). e.g. TRUSTED_PROXIES=10.0.0.0/8
TRUSTED_PROXIES=127.0.0.1/32,::1/128

# Server-fixed workspace for pre-auth transactions (sessions, credentials,
# invitations — never client-supplied). Empty = first workspace in DB.
DEFAULT_WORKSPACE_ID=

# HMAC key for cursors / CSRF / signed URLs (base64 or raw string).
# REQUIRED in production, must be ≥32 bytes. Dev/test fall back to a
# built-in dev key when unset.
OUTREACH_HMAC_KEY=
# AES-256 key for the file SecretStore — 64 hex chars. Dev/test fall back to
# a fixed key when unset; REQUIRED in prod.
OUTREACH_SECRET_KEY=

OBJECTS_DIR=var/objects                      # ObjectStore root (import files, attachments)
SECRETS_FILE=var/secrets.json                # file SecretStore (dev)
SESSION_TTL_SECONDS=43200
WORKER_CONCURRENCY=4                           # max concurrent job handlers per worker poll

MCP_ALLOWED_ORIGINS=                         # CSV Origin allowlist for /mcp; empty = deny browser origins
FAKE_PROVIDER_SCRIPT=                        # JSON script driving Fake provider outcomes (dev/test)

# Admin password for `outreach-cli bootstrap` — never pass a password via
# argv. Alternatives: --admin-password-stdin, or --password-out <path> to
# write a generated one (mode 0600).
OUTREACH_ADMIN_PASSWORD=

# seed-demo is dev/test-only and requires the cli testing feature:
#   cargo run -p cli --features testing -- seed-demo

# Zoho Campaigns marketing OAuth (US/free account). Register a Server-based
# Application at https://api-console.zoho.com/ and use the exact callback shown
# in Settings > Mail accounts > Zoho Campaigns. The binaries do not load .env;
# source your private environment before starting/restarting the API/worker.
ZOHO_CAMPAIGNS_CLIENT_ID=
ZOHO_CAMPAIGNS_CLIENT_SECRET=
# Defaults to PUBLIC_BASE_URL + /api/v1/integrations/zoho-campaigns/callback
ZOHO_CAMPAIGNS_REDIRECT_URI=
# Zoho Mail is a separate integration; no development client ID is invented.
ZOHO_MAIL_CLIENT_ID=
ZOHO_MAIL_REDIRECT_URI=

ZOHO_MAIL_CLIENT_SECRET=
# Optional separate prepaid Zoho Email API organization; disabled by default.
# This is not the Campaigns Free OAuth connection. Keep keys server-side.
ZOHO_EMAIL_API_ENABLED=false
ZOHO_EMAIL_API_KEY=
ZOHO_EMAIL_API_WORKSPACE_ID=
