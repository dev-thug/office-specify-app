{
  "components": {
    "schemas": {
      "AcceptInvitationRequest": {
        "additionalProperties": false,
        "properties": {
          "display_name": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        },
        "required": [
          "display_name",
          "password"
        ],
        "type": "object"
      },
      "ErrorCode": {
        "description": "Stable API error codes. Includes every code in source B.5 plus the generic\ntransport-level codes of spec §4.3. Serialization is the wire string.",
        "enum": [
          "VALIDATION_FAILED",
          "NOT_FOUND",
          "FORBIDDEN",
          "CONFLICT",
          "SCOPE_REQUIRED",
          "INVALID_CREDENTIALS",
          "ACCOUNT_LOCKED",
          "CSRF_TOKEN_INVALID",
          "DEPENDENCY_UNAVAILABLE",
          "INTERNAL",
          "AUTHENTICATION_REQUIRED",
          "PRINCIPAL_DISABLED",
          "MAILBOX_ACCESS_DENIED",
          "AGENT_DIRECT_SEND_FORBIDDEN",
          "SELF_APPROVAL_FORBIDDEN",
          "VERSION_PRECONDITION_REQUIRED",
          "VERSION_MISMATCH",
          "IDEMPOTENCY_KEY_REUSED",
          "REQUEST_IN_PROGRESS",
          "SNAPSHOT_MISMATCH",
          "APPROVAL_EXPIRED",
          "RECIPIENT_SUPPRESSED",
          "SEND_BASIS_UNVERIFIED",
          "PROVIDER_POLICY_BLOCKED",
          "PROVIDER_POLICY_UNVERIFIED",
          "TEMPLATE_VARIABLE_MISSING",
          "REPLY_CONTEXT_CHANGED",
          "REPLY_ALREADY_SUBMITTED",
          "RECIPIENT_ACTIVE_ELSEWHERE",
          "SLOT_UNAVAILABLE",
          "BOOKING_LINK_EXPIRED",
          "BOOKING_RECIPIENT_MISMATCH",
          "RATE_LIMITED",
          "INTEGRATION_REAUTH_REQUIRED",
          "CALENDAR_AVAILABILITY_UNAVAILABLE",
          "PROVIDER_SUBMISSION_OUTCOME_UNKNOWN",
          "WORKSPACE_EMERGENCY_STOP"
        ],
        "type": "string"
      },
      "InvitationPreviewResponse": {
        "properties": {
          "email": {
            "type": "string"
          },
          "expires_at": {
            "format": "date-time",
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          }
        },
        "required": [
          "email",
          "role",
          "expires_at"
        ],
        "type": "object"
      },
      "LoginRequest": {
        "additionalProperties": false,
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ],
        "type": "object"
      },
      "MeMailAccount": {
        "properties": {
          "address": {
            "type": "string"
          },
          "allowed_actions": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": [
          "id",
          "address",
          "allowed_actions"
        ],
        "type": "object"
      },
      "MeResponse": {
        "description": "`GET /me` payload (B.3.1).",
        "properties": {
          "display_name": {
            "type": "string"
          },
          "kind": {
            "$ref": "#/components/schemas/PrincipalKind"
          },
          "mail_accounts": {
            "items": {
              "$ref": "#/components/schemas/MeMailAccount"
            },
            "type": "array"
          },
          "permission_version": {
            "format": "int64",
            "type": "integer"
          },
          "principal_id": {
            "format": "uuid",
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          },
          "workspace_id": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": [
          "principal_id",
          "kind",
          "role",
          "workspace_id",
          "display_name",
          "permission_version",
          "mail_accounts"
        ],
        "type": "object"
      },
      "PrincipalKind": {
        "enum": [
          "human",
          "agent",
          "system"
        ],
        "type": "string"
      },
      "Problem": {
        "description": "RFC 9457 problem detail with project extensions (B.1.2).",
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string"
          },
          "request_id": {
            "type": "string"
          },
          "retryable": {
            "type": "boolean"
          },
          "status": {
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "violations": {
            "items": {
              "$ref": "#/components/schemas/Violation"
            },
            "type": "array"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "code",
          "detail",
          "instance",
          "request_id",
          "retryable"
        ],
        "type": "object"
      },
      "Role": {
        "enum": [
          "admin",
          "manager",
          "member",
          "agent",
          "system"
        ],
        "type": "string"
      },
      "Violation": {
        "description": "Field-level violation inside a problem detail (B.1.2).",
        "properties": {
          "code": {
            "type": "string"
          },
          "field": {
            "type": "string"
          }
        },
        "required": [
          "field",
          "code"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "contact": {
      "email": "juha7kukkonen@gmail.com",
      "name": "Juha Kukkonen"
    },
    "description": "Utoipa's axum bindings for seamless integration for the two",
    "license": {
      "identifier": "MIT OR Apache-2.0",
      "name": "MIT OR Apache-2.0"
    },
    "title": "utoipa-axum",
    "version": "0.2.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/auth/invitations/{token}": {
      "get": {
        "operationId": "invitation_preview",
        "parameters": [
          {
            "description": "One-time invitation token",
            "in": "path",
            "name": "token",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvitationPreviewResponse"
                }
              }
            },
            "description": "Invitation preview"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Not found or expired"
          }
        }
      }
    },
    "/api/v1/auth/invitations/{token}/accept": {
      "post": {
        "operationId": "invitation_accept",
        "parameters": [
          {
            "in": "path",
            "name": "token",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AcceptInvitationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            },
            "description": "Account created; session cookies set"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Validation failed"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Invitation not found or expired"
          }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "operationId": "login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            },
            "description": "Authenticated; sets outreach_session + outreach_csrf cookies"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Invalid credentials"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Account locked / rate limited"
          }
        }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "operationId": "logout",
        "responses": {
          "204": {
            "description": "Session revoked"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unauthenticated"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "CSRF failure"
          }
        }
      }
    },
    "/api/v1/me": {
      "get": {
        "operationId": "me",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            },
            "description": "Current principal"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unauthenticated"
          }
        }
      }
    }
  }
}
